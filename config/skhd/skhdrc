# ---------------------------------------------------------------------------
# skhd config — idiomatic yabai/bspwm-style BSP scheme. Same hjkl layout at
# four modifier tiers: alt=focus, shift+alt=swap, ctrl+alt=warp, cmd+alt=resize.
# See the cheatsheet artifact for the concepts behind each tier.
# ---------------------------------------------------------------------------

# -- focus: move keyboard focus, nothing else changes --
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# -- swap: exchange the focused window with its neighbor --
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# -- warp: move the focused window into the tree at that position --
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - l : yabai -m window --warp east

# -- resize: grow/shrink the focused window along that edge --
cmd + alt - h : yabai -m window --resize left:-40:0
cmd + alt - j : yabai -m window --resize bottom:0:40
cmd + alt - k : yabai -m window --resize top:0:-40
cmd + alt - l : yabai -m window --resize right:40:0

# -- app launch/focus: bring the app to front, or launch it if it's not
# running (macOS's `open -a` does both) --
cmd + alt - b : open -a "Zen"       # browser
cmd + alt - c : open -a "Zed"       # editor
cmd + alt - t : open -a "Ghostty"   # terminal
cmd + alt - s : open -a "Slack"     # comms
cmd + alt - o : open -a "Obsidian"  # notes (floats via the manage=off rule)

# -- scratchpad: quake-style drop-down terminal. First press shows Ghostty
# floated/centered; press again while it's frontmost to hide it (not close
# it) so your shell session survives. Bare F12, no modifier, matching the
# usual Guake/Yakuake/Tilda convention -- if your keyboard's F-keys are
# mapped to media controls by default, use fn+F12, or rebind this.
f12 : $HOME/.config/skhd/scripts/scratchpad.sh

# -- move the focused window to another display, and follow it (useful with
# your two external monitors) --
shift + cmd - h : yabai -m window --display prev; yabai -m display --focus prev
shift + cmd - l : yabai -m window --display next; yabai -m display --focus next

# -- theming: cycle theme family (Gruvbox Dark/Light, Nord, Tokyo Night,
# Catppuccin, ...) across Ghostty + Zed + borders + wallpaper. Each family
# entry now has its own fixed light/dark mode and forces macOS's actual
# appearance to match on switch, so there's no separate light/dark toggle
# anymore (dropped ctrl+alt+d / toggle-light-dark.sh) -- pick "X Dark" or
# "X Light" directly instead. --
ctrl + alt - t : $HOME/.config/theme/cycle-family.sh

# -- layout operations --
shift + alt - f : yabai -m window --toggle zoom-fullscreen   # fullscreen in place
shift + alt - t : yabai -m window --toggle float              # float / re-tile
shift + alt - e : yabai -m space --balance                    # equalize split sizes
shift + alt - r : yabai -m space --rotate 90                  # rotate tree 90°
shift + alt - y : yabai -m space --mirror y-axis               # flip vertically
shift + alt - x : yabai -m space --mirror x-axis               # flip horizontally
shift + alt - s : yabai -m window --toggle split               # toggle this node's split orientation

# -- center the focused window (floats it first if needed) --
shift + alt - c : $HOME/.config/skhd/scripts/center.sh

# -- stacking: group the focused window with the most-recent one, then
# cycle through tree/stack order with next/prev (this also moves between
# windows within a stack) --
shift + alt - z : yabai -m window --stack recent
alt - n         : yabai -m window --focus next
alt - p         : yabai -m window --focus prev

# -- spaces: focus / send / send-and-follow -- ctrl (not alt) so this
# doesn't swallow Option+number, which types special characters on a UK
# keyboard (Option+3 = #, Option+2 = €, etc). cmd+alt is untouched, no
# conflict there. --
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6

ctrl + shift - 1 : yabai -m window --space 1
ctrl + shift - 2 : yabai -m window --space 2
ctrl + shift - 3 : yabai -m window --space 3
ctrl + shift - 4 : yabai -m window --space 4
ctrl + shift - 5 : yabai -m window --space 5
ctrl + shift - 6 : yabai -m window --space 6

cmd + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
cmd + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
cmd + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
cmd + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
cmd + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
cmd + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6

# -- service control --
ctrl + alt - r : yabai --restart-service
ctrl + alt - s : skhd --restart-service
